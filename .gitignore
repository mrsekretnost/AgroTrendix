# ==========================================
# Правила исключения .gitignore
# Проект «АгроТрендикс» (AgroTrendix)
# ==========================================

# Временные файлы офисных приложений (Microsoft Office / LibreOffice)
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp

# Байткод и кэш Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Локальные конфигурации и переменные окружения
.env
.env.local
local_settings.py
*.local

# Базы данных для локальной разработки
*.sqlite3
*.db

# Файлы сред разработки и редакторов кода
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Логи и временные файлы
*.log
logs/
tmp/
temp/

# Отчёты тестирования и покрытия кода
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Сборка и распространение
build/
dist/
*.egg-info/
.eggs/

# Системные файлы ОС
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
